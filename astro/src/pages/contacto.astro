---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Contacto" description="Contactar con el Gabinete de Análisis Transaccional">
  <div class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-4xl font-bold mb-8">Contacto</h1>
    
    <p class="text-lg mb-8">Para estar EN CONTACTO puedes utilizar las siguientes referencias de contacto:</p>
    
    <div class="space-y-6">
      <div class="flex items-start gap-4">
        <span class="text-muted-foreground font-medium w-32">Correo electrónico:</span>
        <a href="mailto:jcuadrap@gmail.com" class="text-primary hover:underline">jcuadrap@gmail.com</a>
      </div>
      
      <div class="flex items-start gap-4">
        <span class="text-muted-foreground font-medium w-32">WhatsApp:</span>
        <a href="https://wa.me/34600290544" class="text-primary hover:underline">00 34 600 290 544</a>
      </div>
      
      <div class="flex items-start gap-4">
        <span class="text-muted-foreground font-medium w-32">Correo postal:</span>
        <address class="not-italic">
          Gabinete de Análisis Transaccional<br/>
          Jesús Cuadra Pérez<br/>
          Moncasi, 26, 4ºD<br/>
          50006 Zaragoza<br/>
          ESPAÑA
        </address>
      </div>
    </div>
  </div>
</BaseLayout>
