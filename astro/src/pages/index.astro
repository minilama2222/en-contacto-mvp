---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getContent } from "@/utils/content";

const psicoterapiaPages = getContent('psicoterapia');
const formacionPages = getContent('formacion');
---

<BaseLayout title="Inicio" description="Gabinete de Análisis Transaccional - Psicología Clínica y Formación">

  <div class="container mx-auto px-4 py-6">
    <div class="flex flex-col lg:flex-row gap-8">
      
      <!-- Main Content - Left Side -->
      <div class="lg:w-2/3">
        
        <!-- Introducción del sitio -->
        <section class="pb-8 mb-8 border-b">
          <div class="prose prose-lg max-w-none">
            <p class="text-xl font-medium mb-4">¡Bienvenidos al sitio web del Gabinete de Análisis Transaccional!</p>
            <p class="mb-4">Este es un Centro profesional de Psicología Clínica dedicado desde 1987 principalmente a la psicoterapia individual y en grupo, de pareja y de familia.</p>
            <p class="font-semibold mb-2">Y también:</p>
            <ul class="list-disc pl-6 mb-4 space-y-1">
              <li>Al crecimiento o desarrollo personal,</li>
              <li>a la prevención de la salud mental y emocional,</li>
              <li>a la orientación a padres y profesores para mejorar la comunicación interpersonal,</li>
              <li>al desarrollo de las habilidades sociales, la creatividad y la asertividad,</li>
              <li>a la resolución de problemas y a la resolución de conflictos.</li>
              <li>Al entrenamiento y la formación profesional en Análisis Transaccional según las normas de entrenamiento del Comité Internacional para la Certificación en Análisis Transaccional de la ITAA y EATA. Esto incluye formación, capacitación y supervisión de la aplicación del Análisis Transaccional a las distintas actividades profesionales.</li>
              <li>Al entrenamiento y la formación en Psicoterapia Integrativa según las pautas de la Asociación Internacional de Psicoterapia Integrativa IIPA.</li>
            </ul>
            <p class="mb-4">En esta sección puedes encontrar información sobre:</p>
            <ul class="list-disc pl-6 mb-4 space-y-1">
              <li><a href="/quien-soy/">Quién soy</a> como profesional y mi trayectoria.</li>
              <li>La <a href="/psicoterapia/">Psicoterapia</a> con una <a href="/psicoterapia/area-de-clientes/">Área dedicada a los clientes</a> de Psicoterapia.</li>
            </ul>
            <p class="mb-4">Te invito a navegar por los menús de la cabecera de la página donde puedes encontrar bastante información sobre:</p>
            <ul class="list-disc pl-6 mb-4 space-y-1">
              <li><a href="/analisis-transaccional">Qué es el Análisis Transaccional</a></li>
              <li>La <a href="/formacion">Formación en Análisis Transaccional Integrativo</a> con diversos Materiales útiles para el desarrollo de los programas de entrenamiento en Análisis Transaccional y de la Psicoterapia Integrativa.</li>
              <li><a href="/certificacion">La Certificación en AT</a> bajo las normas de entrenamiento de la Asociación Europea de Análisis Transaccional (EATA) y de la Asociación Internacional de Análisis Transaccional (ITAA)</li>
              <li>Y sobre otros asuntos relacionados con el Gabinete de Análisis Transaccional y los temas afines al mismo.</li>
            </ul>
            <p>Si lo deseas, <a href="/contacto">Contacta</a> con nosotros y/o déjanos tus opiniones y sugerencias.</p>
          </div>
        </section>

        <!-- Sección Secciones Principales -->
        <section class="pb-8">
          <div class="grid md:grid-cols-2 gap-6">
            <a href="/analisis-transaccional" class="block p-6 rounded-lg border hover:bg-accent transition-colors">
              <h2 class="text-xl font-semibold mb-2">Análisis Transaccional</h2>
              <p class="text-muted-foreground">Teoría de la personalidad y las relaciones humanas.</p>
            </a>

            <a href="/psicoterapia" class="block p-6 rounded-lg border hover:bg-accent transition-colors">
              <h2 class="text-xl font-semibold mb-2">Psicoterapia</h2>
              <p class="text-muted-foreground">{psicoterapiaPages.length} artículos sobre el proceso terapéutico.</p>
            </a>

            <a href="/formacion" class="block p-6 rounded-lg border hover:bg-accent transition-colors">
              <h2 class="text-xl font-semibold mb-2">Formación</h2>
              <p class="text-muted-foreground">{formacionPages.length} recursos sobre formación y certificación.</p>
            </a>
          </div>
        </section>

        <!-- Quién soy (visible en mobile, hidden en lg+) -->
        <section class="lg:hidden bg-muted/30 py-12 -mx-4 px-4">
          <h2 class="text-2xl font-bold mb-6">Quién soy</h2>
          <div class="flex flex-col sm:flex-row gap-6 items-start">
            <div class="sm:w-1/3 flex justify-center">
              <a href="/quien-soy/" class="block bg-white rounded-lg p-3 shadow-sm hover:shadow-md transition-shadow">
                <img 
                  src="https://www.en-contacto.net/wp-content/uploads/FOTO-JESUS.png" 
                  alt="Jesús Cuadra Pérez" 
                  class="w-32 sm:w-full max-w-[180px] mx-auto rounded-lg"
                />
              </a>
            </div>
            <div class="sm:w-2/3 prose text-sm">
              <p>Psicólogo Especialista en Psicología Clínica, Analista Transaccional Psicoterapeuta (ITAA-EATA), Docente y Supervisor.</p>
              <p><a href="/quien-soy/" class="text-primary hover:underline">Más información →</a></p>
            </div>
          </div>
        </section>

        <!-- Organizaciones de AT (visible en mobile, hidden en lg+) -->
        <section class="lg:hidden py-12">
          <h2 class="text-2xl font-bold mb-6">Organizaciones de AT</h2>
          
          <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4">
            <div>
              <h3 class="text-lg font-semibold mb-3">Internacional</h3>
              <ul class="space-y-2 text-sm">
                <li>
                  <a href="https://itaaworld.com/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                    ITAA
                  </a>
                </li>
              </ul>
            </div>
            
            <div>
              <h3 class="text-lg font-semibold mb-3">Europa</h3>
              <ul class="space-y-2 text-sm">
                <li>
                  <a href="http://www.eatanews.org/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                    EATA
                  </a>
                </li>
              </ul>
            </div>
            
            <div>
              <h3 class="text-lg font-semibold mb-3">España</h3>
              <ul class="space-y-2 text-sm">
                <li>
                  <a href="http://www.atainfo.org/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                    ATA
                  </a>
                </li>
                <li>
                  <a href="https://aespat.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                    AESPAT
                  </a>
                </li>
                <li>
                  <a href="https://acat.cat/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                    ACAT
                  </a>
                </li>
                <li>
                  <a href="https://apphat.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                    APPHAT
                  </a>
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-lg font-semibold mb-3">Zaragoza</h3>
              <ul class="space-y-2 text-sm">
                <li>
                  <a href="https://www.coppa.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                    COPPA
                  </a>
                </li>
                <li>
                  <a href="https://mariareula.com/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                    María Reula
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </section>

      </div>

      <!-- Sidebar - Right Side (hidden on mobile, visible on lg+) -->
      <aside class="hidden lg:block lg:w-1/3">
        <div class="sticky top-24 space-y-6">
          
          <!-- Quién soy -->
          <div class="bg-muted/30 rounded-lg p-6">
            <h3 class="text-xl font-semibold mb-4">Quién soy</h3>
            <div class="flex justify-center mb-4">
              <a href="/quien-soy/" class="block bg-white rounded-lg p-2 shadow-sm hover:shadow-md transition-shadow">
                <img 
                  src="https://www.en-contacto.net/wp-content/uploads/FOTO-JESUS.png" 
                  alt="Jesús Cuadra Pérez" 
                  class="w-32 mx-auto rounded-lg"
                />
              </a>
            </div>
            <p class="text-sm text-muted-foreground mb-3">
              Psicólogo Especialista en Psicología Clínica, Analista Transaccional Psicoterapeuta (ITAA-EATA), Docente y Supervisor.
            </p>
            <a href="/quien-soy/" class="text-primary hover:underline text-sm">
              Más información →
            </a>
          </div>

          <!-- Organizaciones de AT -->
          <div class="bg-muted/30 rounded-lg p-6">
            <h3 class="text-xl font-semibold mb-4">Organizaciones de AT</h3>
            
            <h4 class="text-sm font-semibold mb-2 text-muted-foreground">Internacional</h4>
            <ul class="space-y-1 mb-4">
              <li>
                <a href="https://itaaworld.com/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline text-sm">
                  ITAA
                </a>
              </li>
            </ul>
            
            <h4 class="text-sm font-semibold mb-2 text-muted-foreground">Europa</h4>
            <ul class="space-y-1 mb-4">
              <li>
                <a href="http://www.eatanews.org/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline text-sm">
                  EATA
                </a>
              </li>
            </ul>
            
            <h4 class="text-sm font-semibold mb-2 text-muted-foreground">España</h4>
            <ul class="space-y-1 mb-4">
              <li>
                <a href="http://www.atainfo.org/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline text-sm">
                  ATA
                </a>
              </li>
              <li>
                <a href="https://aespat.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline text-sm">
                  AESPAT
                </a>
              </li>
              <li>
                <a href="https://acat.cat/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline text-sm">
                  ACAT
                </a>
              </li>
              <li>
                <a href="https://apphat.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline text-sm">
                  APPHAT
                </a>
              </li>
            </ul>

            <h4 class="text-sm font-semibold mb-2 text-muted-foreground">Zaragoza</h4>
            <ul class="space-y-1">
              <li>
                <a href="https://www.coppa.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline text-sm">
                  COPPA
                </a>
              </li>
              <li>
                <a href="https://mariareula.com/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline text-sm">
                  María Reula
                </a>
              </li>
            </ul>
          </div>

        </div>
      </aside>

    </div>
  </div>
</BaseLayout>