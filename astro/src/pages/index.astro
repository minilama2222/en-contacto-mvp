---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getContent } from "@/utils/content";

const psicoterapiaPages = getContent('psicoterapia');
const formacionPages = getContent('formacion');
---

<BaseLayout title="Inicio" description="Gabinete de Análisis Transaccional - Psicología Clínica y Formación">

  <!-- Sección Secciones Principales -->
  <section class="py-3">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <a href="/analisis-transaccional" class="block p-6 rounded-lg border hover:bg-accent transition-colors">
          <h2 class="text-xl font-semibold mb-2">Análisis Transaccional</h2>
          <p class="text-muted-foreground">Teoría de la personalidad y las relaciones humanas.</p>
        </a>

        <a href="/psicoterapia" class="block p-6 rounded-lg border hover:bg-accent transition-colors">
          <h2 class="text-xl font-semibold mb-2">Psicoterapia</h2>
          <p class="text-muted-foreground">{psicoterapiaPages.length} artículos sobre el proceso terapéutico.</p>
        </a>

        <a href="/formacion" class="block p-6 rounded-lg border hover:bg-accent transition-colors">
          <h2 class="text-xl font-semibold mb-2">Formación</h2>
          <p class="text-muted-foreground">{formacionPages.length} recursos sobre formación y certificación.</p>
        </a>

      </div>
    </div>
  </section>

  <!-- Sección Quién soy -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold mb-8 text-center">Quién soy</h2>
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row gap-8 items-start">
        <div class="md:w-1/3 flex justify-center">
          <a href="/quien-soy/" class="block bg-white rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
            <img 
              src="https://www.en-contacto.net/wp-content/uploads/FOTO-JESUS.png" 
              alt="Jesús Cuadra Pérez" 
              class="w-48 md:w-full max-w-[250px] mx-auto rounded-lg"
            />
          </a>
        </div>
        <div class="md:w-2/3 prose">
          <p>Psicólogo Especialista en Psicología Clínica (colegiado A-282), Analista Transaccional Psicoterapeuta (ITAA-EATA), Analista Transaccional Docente y Supervisor (ITAA-EATA), Psicoterapeuta Integrativo Docente y Supervisor (IIPA).</p>
          
          <p>Inauguré el Gabinete de Análisis Transaccional en el año 1987 en Zaragoza. En el Gabinete mi actividad principal ha sido la Psicoterapia individual, en grupo, de pareja y de familia.</p>
          
          <p>Actualmente, desde enero de 2021, ofrezco entrenamiento en Análisis Transaccional Integrativo ONLINE para profesionales que se dedican a la relación de ayuda.</p>
          
          <p><a href="/quien-soy/" class="text-primary hover:underline">Más información sobre Jesús Cuadra →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección Organizaciones de AT -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold mb-8 text-center">Organizaciones de AT</h2>
      
      <div class="max-w-4xl mx-auto">
        <h3 class="text-xl font-semibold mb-4">Internacional</h3>
        <ul class="space-y-2 mb-8">
          <li>
            <a href="https://itaaworld.com/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              ITAA - Asociación Internacional de Análisis Transaccional
            </a>
          </li>
        </ul>
        
        <h3 class="text-xl font-semibold mb-4">Europa</h3>
        <ul class="space-y-2 mb-8">
          <li>
            <a href="http://www.eatanews.org/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              EATA - Asociación Europea de Análisis Transaccional
            </a>
          </li>
        </ul>
        
        <h3 class="text-xl font-semibold mb-4">España</h3>
        <ul class="space-y-2 mb-8">
          <li>
            <a href="http://www.atainfo.org/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              ATA - Asociación de Análisis Transaccional
            </a>
          </li>
          <li>
            <a href="https://aespat.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              AESPAT - Asociación Española de Análisis Transaccional
            </a>
          </li>
          <li>
            <a href="https://acat.cat/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              ACAT - Asociación Catalana de Análisis Transaccional
            </a>
          </li>
          <li>
            <a href="https://apphat.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              APPHAT - Asociación de Profesionales de Psicología Humanista y Análisis Transaccional
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Sección Enlaces en Zaragoza -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold mb-8 text-center">Enlaces en Zaragoza</h2>
      
      <div class="max-w-4xl mx-auto">
        <ul class="space-y-2">
          <li>
            <a href="http://www.atainfo.org/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              ATA - Asociación de Análisis Transaccional
            </a>
          </li>
          <li>
            <a href="https://www.coppa.es/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              COPPA - Colegio Profesional de Psicólogos de Aragón
            </a>
          </li>
          <li>
            <a href="https://mariareula.com/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              María Reula - Psicología y Psicoterapia Humanista Zaragoza
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
